<mxfile host="metawrap2"><diagram id="bin_refinement" name="BIN_REFINEMENT module"><mxGraphModel grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="panel" value="BIN_REFINEMENT" style="rounded=1;arcSize=3;fillColor=#F2F8EF;strokeColor=#82B366;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=16;fontFamily=Helvetica;container=0;" vertex="1" parent="1"><mxGeometry x="347" y="38" width="1019.35" height="489.5" as="geometry"/></mxCell><mxCell id="inputs" value="Bin sets A–F&lt;br&gt;from any binners" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="25" y="88" width="290" height="64" as="geometry"/></mxCell><mxCell id="prepare" value="Prepare each set&lt;br&gt;keep bins of 50 kb–20 Mb,&lt;br&gt;drop unbinned contigs" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="365" y="78" width="290" height="84" as="geometry"/></mxCell><mxCell id="hybrids" value="Hybrid bin sets&lt;br&gt;Binning_refiner: AB, AC, BC, ABC&lt;br&gt;(pairs and all, for more sets)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="705" y="78" width="290" height="84" as="geometry"/></mxCell><mxCell id="score" value="Score every set&lt;br&gt;CheckM, or CheckM2 with --checkm2;&lt;br&gt;identical bins scored once" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1031.65" y="78" width="316.693" height="84" as="geometry"/></mxCell><mxCell id="checkm_db" value="CheckM or&lt;b